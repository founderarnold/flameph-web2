# Copy to .env.local for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Public site URL (used for QR codes, email links, sitemap)
NEXT_PUBLIC_SITE_URL=https://flameph.org

# Google Maps JavaScript API (Maps JavaScript API + Places API (New) enabled).
# Restrict this browser key by website referrer and API in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=


# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser. Needed for forms, admin console and Ka-FLAME AI logging.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API (server only) for Ka-FLAME AI
ANTHROPIC_API_KEY=
# Fast, low-cost default model; change without a code deploy
ANTHROPIC_MODEL=claude-haiku-5-5
# USD per million tokens, used for cost estimates and the monthly spend cap (defaults match Claude Haiku 5.5)
AI_PRICE_INPUT_PER_MTOK=0.10
AI_PRICE_OUTPUT_PER_MTOK=0.50
# Optional: bearer token for the server-to-server endpoint /api/ai/embed (e.g. MarketplacePH)
AI_EMBED_KEY=

# Transactional email via Resend (optional; without it, submissions are still saved and visible in /admin)
RESEND_API_KEY=
EMAIL_FROM="FLAME PH <noreply@flameph.org>"
NOTIFY_EMAIL=flameph.org@gmail.com

# Salt for hashing visitor IPs (rate limiting). Any long random string.
IP_HASH_SALT=change-me

# Optional: Facebook app id enables the Messenger web share dialog on desktop
NEXT_PUBLIC_FB_APP_ID=

# Optional: push notifications for members (new inquiries, weekly picks). Generate once with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Weekly member email digest (Vercel Cron, see vercel.json). Any long random string; Vercel sends it automatically.
CRON_SECRET=
